# Copy to .env.local and fill in. EXPO_PUBLIC_* values are bundled into the
# app, so only put public values here (never the service role key or Teller
# certificate).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_TELLER_APP_ID=app_xxxxxxxxxxxx
# sandbox | development | production
EXPO_PUBLIC_TELLER_ENV=sandbox
