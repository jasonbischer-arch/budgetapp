# Public app settings. EXPO_PUBLIC_* values are bundled into the app, so only
# public values belong here: never the Supabase service role key or Plaid
# secret (those live in Supabase -> Edge Functions -> Secrets).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
